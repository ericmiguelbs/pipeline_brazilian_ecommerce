
# Kaggle
KAGGLE_API_TOKEN=''


# Caminhos do Data Lake (Medallion)

PASTA_BRONZE=./dados/bronze
PASTA_SILVER=./dados/silver


# PostgreSQL – Data Warehouse (Gold)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dw_gold
POSTGRES_HOST=postgres_gold
POSTGRES_PORT=5432


# Airflow

FERNET_KEY=''
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
AIRFLOW_UID=50000

# Credenciais do usuário admin criado na inicialização
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Caminho do projeto (usado pelo docker-compose para montar volumes)
AIRFLOW_PROJ_DIR=.

# Arquivo .env a ser carregado pelos containers (padrão: .env)
ENV_FILE_PATH=.env
